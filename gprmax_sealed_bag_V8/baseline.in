#title: Baseline wet soil only no bag

#domain: 0.6 1.533 0.003
#dx_dy_dz: 0.003 0.003 0.003
#time_window: 3e-08

#pml_cells: 10 10 0 10 0 0

## Materials
#material: 18 0.02 1 0 soil_wet

## Fill domain
#box: 0 0 0 0.6 1.5 0.003 soil_wet
#box: 0 1.5 0 0.6 1.533 0.003 free_space

#waveform: gaussian 1 1610000000.0 mypulse

## Start position - run with -n 21 for full B-scan sweep
#hertzian_dipole: z 0.05 1.503 0.0015 mypulse
#rx: 0.15 1.503 0.0015
#src_steps: 0.02 0 0
#rx_steps: 0.02 0 0
